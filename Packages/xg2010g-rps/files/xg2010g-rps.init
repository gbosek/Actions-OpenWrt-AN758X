#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
	IFS= read -r board < /tmp/sysinfo/board_name 2>/dev/null || return 0
	[ "$board" = "gemtek,xg2010g" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/rps-watch.sh
	procd_set_param respawn
	procd_close_instance
}
