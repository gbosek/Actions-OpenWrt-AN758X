diff --git a/files/lib/mwan4/mwan4.uc b/files/lib/mwan4/mwan4.uc
--- a/files/lib/mwan4/mwan4.uc
+++ b/files/lib/mwan4/mwan4.uc
@@ -1257,8 +1257,8 @@
 		push(L, sprintf('\t\tmeta mark & %s == 0 jump %s_strategy_%s_%s',
