#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Shared CPU policy owner for both NPU LuCI variants.
CPU_ROOT="${XG_CPU_ROOT:-/sys/devices/system/cpu/cpufreq}"
PLATFORM_ROOT="${XG_PLATFORM_ROOT:-/sys/bus/platform/devices}"
BOARD_FILE="${XG_BOARD_FILE:-/tmp/sysinfo/board_name}"
UCI="${XG_UCI:-uci}"

board_ok() { local board; IFS= read -r board < "$BOARD_FILE" 2>/dev/null; [ "$board" = 'gemtek,xg2010g' ]; }
policy() {
 local p
 for p in "$CPU_ROOT"/policy[0-9]*; do
  [ -r "$p/scaling_governor" ] && { printf '%s\n' "$p"; return 0; }
 done
 return 1
}
capable() {
 local f cap backend
 for f in "$PLATFORM_ROOT"/*/boost_capable; do
  [ -r "$f" ] || continue
  IFS= read -r cap < "$f" || cap=0
  IFS= read -r backend < "${f%/*}/boost_backend" || backend=unavailable
  [ "$cap" = 1 ] && [ "$backend" = kernel-pll ] && { echo 1; return; }
 done
 echo 0
}
backend() { [ "$(capable)" = 1 ] && echo kernel-pll || echo unavailable; }
frequencies() {
 local p cap
 p="$(policy)" || return 1
 cat "$p/scaling_available_frequencies" 2>/dev/null
 if [ "$(capable)" = 1 ]; then cat "$p/scaling_boost_frequencies" 2>/dev/null; fi
}
frequency_ok() {
 local value f
 value="$1"
 case "$value" in ''|*[!0-9]*) return 1;; esac
 [ "$value" -ge 500000 ] && [ "$value" -le 1400000 ] || return 1
 for f in $(frequencies); do [ "$f" = "$value" ] && return 0; done
 return 1
}
read_value() { local value=""; IFS= read -r value < "$1" 2>/dev/null || [ -n "$value" ] || return 1; printf '%s' "$value"; }
write_value() {
 [ "$(read_value "$1")" = "$2" ] && return 0
 printf '%s\n' "$2" > "$1"
}
apply_ondemand() {
 local p="$1" attribute option limit value directory
 for option in sdfactor upthreshold; do
  value="$("$UCI" -q get "cpufreq.cpufreq.${option}0")"
  [ -n "$value" ] || continue
  case "$value" in *[!0-9]*) return 1;; esac
  case "$option" in
   sdfactor) attribute=sampling_down_factor; limit=100000;;
   upthreshold) attribute=up_threshold; limit=99;;
  esac
  [ "$value" -ge 1 ] && [ "$value" -le "$limit" ] || return 1
  # Kernels may expose governor tunables globally or per policy.
  for directory in "$p/ondemand" "$CPU_ROOT/ondemand"; do
   [ -e "$directory/$attribute" ] || continue
   write_value "$directory/$attribute" "$value" || return 1
   break
  done
 done
 return 0
}
apply_policy() {
 local p cap gov min max boost oldmax g found
 board_ok || return 0
 p="$(policy)" || return 1
 cap="$(capable)"
 gov="$("$UCI" -q get cpufreq.cpufreq.governor0)"; gov="${gov:-ondemand}"
 min="$("$UCI" -q get cpufreq.cpufreq.minfreq0)"; min="${min:-500000}"
 max="$("$UCI" -q get cpufreq.cpufreq.maxfreq0)"; max="${max:-1400000}"
 case "$max" in ''|*[!0-9]*) max=1200000;; esac
 [ "$max" -le 1400000 ] || max=1400000
 if [ "$cap" != 1 ] && [ "$max" -gt 1200000 ]; then
  max=1200000
  save_value maxfreq0 1200000 || return 1
 fi
 frequency_ok "$max" || max=1200000
 frequency_ok "$min" || min=500000
 [ "$min" -le "$max" ] || min=500000
 found=0
 for g in $(cat "$p/scaling_available_governors"); do [ "$g" = "$gov" ] && found=1; done
 [ "$found" = 1 ] || gov=ondemand
 boost=0; [ "$cap" = 1 ] && [ "$max" -gt 1200000 ] && boost=1
 if [ "$boost" = 1 ]; then
  [ -w "$CPU_ROOT/boost" ] || return 1
  write_value "$CPU_ROOT/boost" 1 || return 1
 fi
 oldmax="$(read_value "$p/scaling_max_freq")"
 case "$oldmax" in ''|*[!0-9]*) return 1;; esac
 if [ "$min" -gt "$oldmax" ]; then write_value "$p/scaling_max_freq" "$max" || return 1; fi
 write_value "$p/scaling_min_freq" "$min" || return 1
 write_value "$p/scaling_max_freq" "$max" || return 1
 if [ "$boost" = 0 ] && [ -w "$CPU_ROOT/boost" ]; then write_value "$CPU_ROOT/boost" 0 || return 1; fi
 write_value "$p/scaling_governor" "$gov" || return 1
 [ "$gov" != ondemand ] || apply_ondemand "$p" || return 1
 return 0
}
save_value() {
 "$UCI" -q get cpufreq.cpufreq >/dev/null || "$UCI" set cpufreq.cpufreq=cpufreq || return 1
 "$UCI" -q get cpufreq.global >/dev/null || "$UCI" set cpufreq.global=global || return 1
 "$UCI" set "cpufreq.cpufreq.$1=$2" || return 1
 "$UCI" set cpufreq.global.set=1 || return 1
 "$UCI" commit cpufreq || return 1
 if [ -f /etc/config/airoha_npu ]; then
  case "$1" in governor0) "$UCI" set "airoha_npu.@cpu[0].governor=$2";; maxfreq0) "$UCI" set "airoha_npu.@cpu[0].max_freq=$2";; esac
  "$UCI" commit airoha_npu || return 1
 fi
}
error() { printf '{"error":"%s"}\n' "$1"; exit 1; }
case "${1:-apply}" in
 cap) capable;;
 backend) backend;;
 frequencies) frequencies | tr ' ' '\n' | sed '/^$/d' | sort -n -u;;
 apply) apply_policy;;
 set-governor)
  board_ok || error 'Unsupported board'
  p="$(policy)" || error 'CPU frequency scaling unavailable'
  found=0
  for g in $(cat "$p/scaling_available_governors"); do [ "$g" = "$2" ] && found=1; done
  [ "$found" = 1 ] || error 'Unsupported governor'
  save_value governor0 "$2" && apply_policy || error 'CPU governor could not be applied'
  printf '{"result":"ok","governor":"%s"}\n' "$2";;
 set-max)
  board_ok || error 'Unsupported board'
  frequency_ok "$2" || error 'Frequency unavailable or boost backend unsupported'
  save_value maxfreq0 "$2" && apply_policy || error 'CPU frequency limit could not be applied'
  p="$(policy)" || error 'CPU frequency scaling unavailable'
  [ "$(read_value "$p/scaling_max_freq")" = "$2" ] || error 'Requested ceiling unavailable; fallback policy applied'
  printf '{"result":"ok","freq":%s}\n' "$2";;
 *) error 'Unknown CPU policy command';;
esac
