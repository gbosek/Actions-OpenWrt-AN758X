#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0
START=25
STOP=10
USE_PROCD=1
extra_command "get_policies" "Get CPU scaling governors and frequencies"
get_policies() {
 local policy index freq governor
 json_init
 for policy in /sys/devices/system/cpu/cpufreq/policy[0-9]*; do
  [ -r "$policy/scaling_governor" ] || continue
  index="${policy##*policy}"
  json_add_object "policy$index"
  json_add_string index "$index"
  json_add_string cpus "$(cat "$policy/affected_cpus")"
  json_add_string boost_backend "$(/usr/libexec/xg2010g-cpu-policy backend)"
  json_add_array freqs
  for freq in $(/usr/libexec/xg2010g-cpu-policy frequencies); do json_add_string '' "$freq"; done
  json_close_array
  json_add_array governors
  for governor in $(cat "$policy/scaling_available_governors"); do json_add_string '' "$governor"; done
  json_close_array
  json_close_object
 done
 json_dump
}
start_service() {
 procd_open_instance
 procd_set_param command /usr/libexec/xg2010g-cpu-policy watch
 procd_set_param respawn
 procd_close_instance
}
reload_service() { /usr/libexec/xg2010g-cpu-policy apply; }
service_triggers() { procd_add_reload_trigger cpufreq; }
