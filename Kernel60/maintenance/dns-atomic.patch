--- a/package/network/services/dnsmasq/files/dnsmasq.init
+++ b/package/network/services/dnsmasq/files/dnsmasq.init
@@ -20,6 +20,7 @@ BASEDHCPSTAMPFILE="/var/run/dnsmasq"
 DHCPBOGUSHOSTNAMEFILE="/usr/share/dnsmasq/dhcpbogushostname.conf"
 RFC6761FILE="/usr/share/dnsmasq/rfc6761.conf"
 DHCPSCRIPT="/usr/lib/dnsmasq/dhcp-script.sh"
+RESOLVCONF="/tmp/resolv.conf.d/resolv.conf"
 DHCPSCRIPT_DEPENDS="/usr/share/libubox/jshn.sh /usr/bin/jshn /bin/ubus /usr/bin/env"
 
 DNSMASQ_DHCP_VER=4
@@ -902,6 +903,12 @@ dnsmasq_ipset_add() {
 	xappend "--nftset=$domains/$nftsets"
 }
 
+dnsmasq_resolvconf_link()
+{
+	[ "$(readlink /tmp/resolv.conf)" = "$RESOLVCONF" ] ||
+		ln -sf "$RESOLVCONF" /tmp/resolv.conf
+}
+
 dnsmasq_start()
 {
 	local cfg="$1"
@@ -1257,15 +1264,17 @@ dnsmasq_start()
 	mv -f "$HOSTFILE_TMP" "$HOSTFILE"
 
 	[ "$localuse" -gt 0 ] && {
-		rm -f /tmp/resolv.conf
+		rm -f "$RESOLVCONF.$cfg"
 		[ $ADD_LOCAL_DOMAIN -eq 1 ] && [ -n "$DOMAIN" ] && {
-			echo "search $DOMAIN" >> /tmp/resolv.conf
+			echo "search $DOMAIN" >> "$RESOLVCONF.$cfg"
 		}
 		DNS_SERVERS="$DNS_SERVERS 127.0.0.1"
 		[ -e /proc/sys/net/ipv6 ] && DNS_SERVERS="$DNS_SERVERS ::1"
 		for DNS_SERVER in $DNS_SERVERS ; do
-			echo "nameserver $DNS_SERVER" >> /tmp/resolv.conf
+			echo "nameserver $DNS_SERVER" >> "$RESOLVCONF.$cfg"
 		done
+		mv -f "$RESOLVCONF.$cfg" "$RESOLVCONF"
+		dnsmasq_resolvconf_link
 	}
 
 	config_list_foreach "$cfg" addnmount append_extramount
@@ -1309,7 +1318,11 @@ dnsmasq_stop()
 
 	[ "$noresolv" = 0 ] && [ "$resolvfile" != "/tmp/resolv.conf.d/resolv.conf.auto" ] && localuse=0
 	config_get_bool localuse "$cfg" localuse "$localuse"
-	[ "$localuse" -gt 0 ] && ln -sf "/tmp/resolv.conf.d/resolv.conf.auto" /tmp/resolv.conf
+	[ "$localuse" -gt 0 ] && {
+		ln -sf resolv.conf.auto "$RESOLVCONF.$cfg"
+		mv -f "$RESOLVCONF.$cfg" "$RESOLVCONF"
+		dnsmasq_resolvconf_link
+	}
 
 	rm -f ${BASEDHCPSTAMPFILE}.${cfg}.*.dhcp
 }
