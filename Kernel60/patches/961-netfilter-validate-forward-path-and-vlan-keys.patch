From: XG2010G firmware maintenance
Subject: [PATCH] netfilter: validate complete paths, mask VLAN VID and reset bridge scope

Based on OpenWrt 2d7e2a4a, be75fbfa, 09fe0f81 (Linux 871df5007eda,
c203ecf90574 and FDB teardown v9). Adapt the existing MTK path type and
bridge conntrack parser; retain native 6.18.60 VLAN-underflow protection.
Propagate parser failure to both routed and bridge callers. No PPE/NPU
threshold, lifetime, policy or board changes.

--- a/net/netfilter/nf_flow_table_path.c
+++ b/net/netfilter/nf_flow_table_path.c
@@ -95,7 +95,7 @@
 	enum flow_offload_xmit_type xmit_type;
 };
 
-static void nft_dev_path_info(const struct net_device_path_stack *stack,
+static int nft_dev_path_info(const struct net_device_path_stack *stack,
 			      struct nft_forward_info *info,
 			      unsigned char *ha, struct nf_flowtable *flowtable)
 {
@@ -128,10 +128,8 @@
 			}
 
 			/* DEV_PATH_VLAN and DEV_PATH_PPPOE */
-			if (info->num_encaps >= NF_FLOW_TABLE_ENCAP_MAX) {
-				info->indev = NULL;
-				break;
-			}
+			if (info->num_encaps >= NF_FLOW_TABLE_ENCAP_MAX)
+				return -ENOENT;
 			if (!info->outdev)
 				info->outdev = path->dev;
 			info->encap[info->num_encaps].id = path->encap.id;
@@ -148,38 +146,35 @@
 
 			switch (path->bridge.vlan_mode) {
 			case DEV_PATH_BR_VLAN_UNTAG_HW:
+				if (!info->num_encaps)
+					return -ENOENT;
 				info->ingress_vlans |= BIT(info->num_encaps - 1);
 				break;
 			case DEV_PATH_BR_VLAN_KEEP_HW:
-				if (info->num_encaps >= NF_FLOW_TABLE_ENCAP_MAX) {
-					info->indev = NULL;
-					break;
-				}
+				if (info->num_encaps >= NF_FLOW_TABLE_ENCAP_MAX)
+					return -ENOENT;
 				info->ingress_vlans |= BIT(info->num_encaps);
 				info->encap[info->num_encaps].id = path->bridge.vlan_id;
 				info->encap[info->num_encaps].proto = path->bridge.vlan_proto;
 				info->num_encaps++;
 				break;
 			case DEV_PATH_BR_VLAN_TAG:
-				if (info->num_encaps >= NF_FLOW_TABLE_ENCAP_MAX) {
-					info->indev = NULL;
-					break;
-				}
+				if (info->num_encaps >= NF_FLOW_TABLE_ENCAP_MAX)
+					return -ENOENT;
 				info->encap[info->num_encaps].id = path->bridge.vlan_id;
 				info->encap[info->num_encaps].proto = path->bridge.vlan_proto;
 				info->num_encaps++;
 				break;
 			case DEV_PATH_BR_VLAN_UNTAG:
-				if (info->num_encaps == 0) {
-					info->indev = NULL;
-					break;
-				}
+				if (!info->num_encaps)
+					return -ENOENT;
 				info->num_encaps--;
 				break;
 			case DEV_PATH_BR_VLAN_KEEP:
 				break;
 			}
 			info->bridge_path = 1;
+			info->port_vlans = 0;
 			n = info->num_encaps;
 			info->bridge_vlan = path->bridge.vlan_id && n &&
 					    info->encap[n - 1].id ==
@@ -189,10 +184,12 @@
 			info->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
 			break;
 		default:
-			info->indev = NULL;
-			break;
+			return -ENOENT;
 		}
 	}
+	if (!info->indev)
+		return -ENOENT;
+
 	if (!info->outdev)
 		info->outdev = info->indev;
 
@@ -201,6 +198,8 @@
 	if (nf_flowtable_hw_offload(flowtable) &&
 	    nft_is_valid_ether_device(info->indev))
 		info->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
+
+	return 0;
 }
 
 static bool nft_flowtable_find_dev(const struct net_device *dev,
@@ -220,7 +219,7 @@
 	return found;
 }
 
-static void nft_dev_forward_path(struct nf_flow_route *route,
+static int nft_dev_forward_path(struct nf_flow_route *route,
 				 const struct nf_conn *ct,
 				 enum ip_conntrack_dir dir,
 				 struct nft_flowtable *ft)
@@ -231,16 +230,15 @@
 	unsigned char ha[ETH_ALEN];
 	int i;
 
-	if (nft_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0)
-		nft_dev_path_info(&stack, &info, ha, &ft->data);
+	if (nft_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) < 0 ||
+	    nft_dev_path_info(&stack, &info, ha, &ft->data) < 0)
+		return -ENOENT;
 
 	if (info.outdev)
 		route->tuple[dir].out.ifindex = info.outdev->ifindex;
-	else
-		route->tuple[dir].out.ifindex = dst->dev->ifindex;
 
 	if (!info.indev || !nft_flowtable_find_dev(info.indev, ft))
-		return;
+		return -ENOENT;
 
 	route->tuple[!dir].in.ifindex = info.indev->ifindex;
 	for (i = 0; i < info.num_encaps; i++) {
@@ -259,6 +257,8 @@
 		route->tuple[dir].out.hw_ifindex = info.hw_outdev->ifindex;
 		route->tuple[dir].xmit_type = info.xmit_type;
 	}
+
+	return 0;
 }
 
 int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
@@ -303,12 +303,19 @@
 	nft_default_forward_path(route, this_dst, dir);
 	nft_default_forward_path(route, other_dst, !dir);
 
-	if (route->tuple[dir].xmit_type	== FLOW_OFFLOAD_XMIT_NEIGH)
-		nft_dev_forward_path(route, ct, dir, ft);
-	if (route->tuple[!dir].xmit_type == FLOW_OFFLOAD_XMIT_NEIGH)
-		nft_dev_forward_path(route, ct, !dir, ft);
+	if (route->tuple[dir].xmit_type == FLOW_OFFLOAD_XMIT_NEIGH &&
+	    nft_dev_forward_path(route, ct, dir, ft) < 0)
+		goto err_dst_release;
+	if (route->tuple[!dir].xmit_type == FLOW_OFFLOAD_XMIT_NEIGH &&
+	    nft_dev_forward_path(route, ct, !dir, ft) < 0)
+		goto err_dst_release;
 
 	return 0;
+
+err_dst_release:
+	dst_release(route->tuple[dir].dst);
+	dst_release(route->tuple[!dir].dst);
+	return -ENOENT;
 }
 EXPORT_SYMBOL_GPL(nft_flow_route);
 
@@ -352,7 +359,8 @@
 	if (dev_fill_bridge_path(&ctx, &stack) < 0)
 		return -1;
 
-	nft_dev_path_info(&stack, &info, dst_ha, &ft->data);
+	if (nft_dev_path_info(&stack, &info, dst_ha, &ft->data) < 0)
+		return -ENOENT;
 
 	if (!info.indev || info.indev != dst_dev)
 		return -1;
@@ -398,7 +406,7 @@
 	tuple =  &flow->tuplehash[!dir].tuple;
 
 	if (skb_vlan_tag_present(pkt->skb)) {
-		tuple->encap[i].id = skb_vlan_tag_get(pkt->skb);
+		tuple->encap[i].id = skb_vlan_tag_get_id(pkt->skb);
 		tuple->encap[i].proto = pkt->skb->vlan_proto;
 		i++;
 	}
@@ -407,7 +415,7 @@
 	case htons(ETH_P_8021Q): {
 		struct vlan_hdr *vhdr = (struct vlan_hdr *)(skb_mac_header(pkt->skb)
 					 + sizeof(struct ethhdr));
-		tuple->encap[i].id = ntohs(vhdr->h_vlan_TCI);
+		tuple->encap[i].id = ntohs(vhdr->h_vlan_TCI) & VLAN_VID_MASK;
 		tuple->encap[i].proto = htons(ETH_P_8021Q);
 		i++;
 		break;
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -150,14 +150,14 @@
 	int i = 0;
 
 	if (skb_vlan_tag_present(skb)) {
-		tuple->encap[i].id = skb_vlan_tag_get(skb);
+		tuple->encap[i].id = skb_vlan_tag_get_id(skb);
 		tuple->encap[i].proto = skb->vlan_proto;
 		i++;
 	}
 	switch (skb->protocol) {
 	case htons(ETH_P_8021Q):
