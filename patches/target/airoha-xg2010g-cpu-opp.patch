diff --git a/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts b/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
--- a/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
+++ b/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
@@ -26,6 +26,9 @@
 	chosen {
 		/* Create fastmap on first attach for boot firmware and Linux reuse. */
 		bootargs = "console=ttyS0,115200 earlycon";
+		/* Keep the boot governor at the minimum until userspace sets its limit. */
+		bootargs-append = " ubi.fm_autoconvert=1 cpufreq.default_governor=powersave";
+
 		rootdisk = <&ubi_fit>;
 		stdout-path = "serial0:115200n8";
 	};
@@ -246,6 +246,39 @@
 	status = "okay";
 };
 
+&cpufreq {
+	reg = <0x0 0x1fa20000 0x0 0x2c0
+	       0x0 0x1efbe000 0x0 0x800>;
+	reg-names = "chip-scu", "mcucfg";
+	airoha,force-direct-pll;
+};
+
+&cpu_opp_table {
+	opp-1250000000 {
+		opp-hz = /bits/ 64 <1250000000>;
+		required-opps = <&smcc_opp15>;
+	};
+	opp-1300000000 {
+		opp-hz = /bits/ 64 <1300000000>;
+		required-opps = <&smcc_opp16>;
+	};
+	opp-1350000000 {
+		opp-hz = /bits/ 64 <1350000000>;
+		required-opps = <&smcc_opp17>;
+	};
+	opp-1400000000 {
+		opp-hz = /bits/ 64 <1400000000>;
+		required-opps = <&smcc_opp18>;
+	};
+};
+
+&cpu_smcc_opp_table {
+	smcc_opp15: opp15 { opp-level = <15>; };
+	smcc_opp16: opp16 { opp-level = <16>; };
+	smcc_opp17: opp17 { opp-level = <17>; };
+	smcc_opp18: opp18 { opp-level = <18>; };
+};
+
 &eth {
 	status = "okay";
 
