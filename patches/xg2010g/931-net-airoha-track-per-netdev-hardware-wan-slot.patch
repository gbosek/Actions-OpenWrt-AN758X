From: OpenAI <noreply@openai.com>
Subject: [PATCH] net: airoha: track per-netdev hardware WAN slot

Prepare the Airoha Ethernet driver for dynamic dual-WAN without changing the
existing datapath.

Keep the logical LAN/WAN role separate from the AN7581 FE hardware WAN
selector. Each net_device records which hardware WAN selector owns it:
NONE, WAN0, or WAN1.

Use zero as NONE so freshly allocated netdev private data naturally starts
unassigned. Existing single-WAN behaviour is preserved by assigning current
WAN devices to WAN0 during ndo_init.

---
 drivers/net/ethernet/airoha/airoha_eth.c | 3 +++
 drivers/net/ethernet/airoha/airoha_eth.h | 7 +++++++
 2 files changed, 10 insertions(+)

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -563,6 +563,12 @@ enum airoha_priv_flags {
 	AIROHA_PRIV_F_PON = BIT(2),
 };
 
+enum airoha_hw_wan_slot {
+	AIROHA_HW_WAN_NONE = 0,
+	AIROHA_HW_WAN0 = 1,
+	AIROHA_HW_WAN1 = 2,
+};
+
 struct airoha_gdm_dev {
 	struct airoha_qdma __rcu *qdma;
 	struct airoha_gdm_port *port;
@@ -614,6 +620,7 @@ struct airoha_gdm_dev {
 
 	u32 flags;
 	int nbq;
+	u8 hw_wan_slot;
 
 	u32 pon_qdma_tag;
 	struct airoha_pon_flow_table __rcu *pon_flow_table;
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2428,6 +2428,9 @@ static int airoha_dev_init(struct net_device *netdev)
 	default:
 		break;
 	}
+
+	if (!airoha_is_lan_gdm_dev(dev))
+		dev->hw_wan_slot = AIROHA_HW_WAN0;
 
 	airoha_dev_set_qdma(dev);
 	airoha_set_macaddr(dev, netdev->dev_addr);
