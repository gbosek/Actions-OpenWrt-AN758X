From: OpenAI <noreply@openai.com>
Subject: [PATCH] net: airoha: track per-netdev hardware WAN slot

Prepare the Airoha Ethernet driver for dynamic dual-WAN without changing the
existing datapath.

Keep the logical LAN/WAN role separate from the AN7581 FE hardware WAN
selector.  Each net_device records which hardware WAN selector owns it:
NONE, WAN0, or WAN1.

Existing single-WAN behaviour is preserved by assigning current WAN devices to
WAN0 during ndo_init.  New devices start with no hardware WAN slot.

Also expose GDM/NBQ/source-port/slot state in PPE debugfs so field testing can
verify the physical net_device-to-hardware mapping.

---
 drivers/net/ethernet/airoha/airoha_eth.c         |  5 +++++
 drivers/net/ethernet/airoha/airoha_eth.h         |  7 +++++++
 drivers/net/ethernet/airoha/airoha_ppe_debugfs.c | 18 ++++++++++++++++++
 3 files changed, 30 insertions(+)

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -563,6 +563,12 @@ enum airoha_priv_flags {
 	AIROHA_PRIV_F_PON = BIT(2),
 };
 
+enum airoha_hw_wan_slot {
+	AIROHA_HW_WAN_NONE = -1,
+	AIROHA_HW_WAN0 = 0,
+	AIROHA_HW_WAN1 = 1,
+};
+
 struct airoha_gdm_dev {
 	struct airoha_qdma __rcu *qdma;
 	struct airoha_gdm_port *port;
@@ -614,6 +620,7 @@ struct airoha_gdm_dev {
 
 	u32 flags;
 	int nbq;
+	s8 hw_wan_slot;
 
 	u32 pon_qdma_tag;
 	struct airoha_pon_flow_table __rcu *pon_flow_table;
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2428,6 +2428,9 @@ static int airoha_dev_init(struct net_device *netdev)
 	default:
 		break;
 	}
+
+	if (!airoha_is_lan_gdm_dev(dev))
+		dev->hw_wan_slot = AIROHA_HW_WAN0;
 
 	airoha_dev_set_qdma(dev);
 	airoha_set_macaddr(dev, netdev->dev_addr);
@@ -3431,6 +3434,8 @@ static int airoha_alloc_gdm_device(struct airoha_eth *eth,
 	dev->port = port;
 	dev->eth = eth;
 	dev->nbq = nbq;
+	dev->hw_wan_slot = AIROHA_HW_WAN_NONE;
+
 	port->devs[index] = dev;
 
 	return 0;
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -214,6 +214,24 @@ static int airoha_ppe_debugfs_config_show(struct seq_file *m, void *private)
 		seq_printf(m, "ppe%u_gdm2_default_cpu_port: %u\n", i,
 			   FIELD_GET(DFT_CPORT_MASK(AIROHA_GDM2_IDX), cport));
 	}
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+		unsigned int j;
+
+		if (!port)
+			continue;
+
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct airoha_gdm_dev *dev = port->devs[j];
+			int sport;
+
+			if (!dev)
+				continue;
+			sport = eth->soc->ops.get_sport(port, dev->nbq);
+			seq_printf(m, "netdev=%s role=%s hw_wan_slot=%d gdm=%d nbq=%d sport=%d\n",
+				   netdev_from_priv(dev)->name,
+				   airoha_is_lan_gdm_dev(dev) ? "lan" : "wan",
+				   dev->hw_wan_slot, port->id, dev->nbq, sport);
+		}
+	}
 
 	return 0;
 }
