--- a/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
+++ b/target/linux/airoha/dts/an7581-gemtek-xg2010g.dts
@@ -25,7 +25,7 @@
 
 	chosen {
 		/* Create fastmap on first attach for boot firmware and Linux reuse. */
-		bootargs = "console=ttyS0,115200 earlycon";
+		bootargs = "console=ttyS0,115200 earlycon cpufreq.default_governor=powersave";
 		rootdisk = <&ubi_fit>;
 		stdout-path = "serial0:115200n8";
 	};
@@ -399,3 +399,26 @@
 	label = "lan4";
 	status = "okay";
 };
+
+/* 1400 MHz is a compatibility boost OPP, not a new ordinary BL31 state. */
+&cpufreq {
+	gemtek,1400mhz-boost;
+	airoha,chip-scu = <&chip_scu>;
+	reg = <0x0 0x1efbe000 0x0 0x1000>;
+	reg-names = "mcucfg";
+};
+
+&cpu_opp_table {
+	opp-1400000000 {
+		opp-hz = /bits/ 64 <1400000000>;
+		required-opps = <&xg2010g_boost_opp>;
+		turbo-mode;
+		clock-latency-ns = <1000000000>;
+	};
+};
+
+&cpu_smcc_opp_table {
+	xg2010g_boost_opp: opp15 {
+		opp-level = <15>;
+	};
+};
