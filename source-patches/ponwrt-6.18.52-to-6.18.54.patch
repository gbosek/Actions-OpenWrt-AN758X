-+			val |= QCA8K_PORT_PAD_SGMII_FORCE_MODE;
-+		mask |= QCA8K_PORT_PAD_SGMII_FORCE_MODE;
-+	}
-+
-+	if (mask)
-+		ret = qca8k_rmw(priv, reg, mask, val);
