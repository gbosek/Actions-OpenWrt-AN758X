- 	int cpu_port_index, ret, port;
--	u32 reg, val;
-+	u32 mask, reg, val;
- 
- 	port = pcs_to_qca8k_pcs(pcs)->port;
- 	switch (port) {
-@@ -1611,11 +1611,21 @@ static int qca8k_pcs_config(struct phyli
- 	if (priv->ports_config.sgmii_tx_clk_falling_edge)
