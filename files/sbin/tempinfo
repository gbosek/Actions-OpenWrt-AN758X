#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# System temperature data for autocore/luci.getTempInfo on Airoha.
# PON telemetry is collected once by the separate 15_pon overview card.

THERMAL_PATH=/sys/class/thermal
IEEE_PATH=/sys/class/ieee80211

fmt_c() {
	[ -r "$1" ] || return
	awk '/^[+-]?[0-9]+$/ { printf "%.1f°C", $0 / 1000 }' "$1" 2>/dev/null
}

out=""
temperature="$(fmt_c "$THERMAL_PATH/thermal_zone0/temp")"
[ -n "$temperature" ] && out="CPU: $temperature"

wifi_temp=""
for path in "$IEEE_PATH"/phy*/hwmon*/temp1_input \
            "$IEEE_PATH"/phy*/device/hwmon/hwmon*/temp1_input; do
	[ -r "$path" ] || continue
	temperature="$(fmt_c "$path")"
	[ -n "$temperature" ] && wifi_temp="${wifi_temp:+$wifi_temp }$temperature"
done
[ -n "$wifi_temp" ] && out="${out:+$out, }WiFi: $wifi_temp"

[ -n "$out" ] || out="No temperature info"
printf '%s' "$out"
