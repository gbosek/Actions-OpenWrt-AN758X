Subject: net: airoha: preserve TC IB1 template during idle refresh

Experimental candidate: copy only the timestamp of a matching bound entry.
Hardware aging/slot reuse and failed invalidation require separate review.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1239,7 +1239,19 @@
 		goto unlock;
 	}
 
-	e->data.ib1 = hwe.ib1;
+	/* UNB timestamps and packet counts overlap the BIND flags.  Keep
+	 * the TC template intact and only refresh a bound entry's timestamp.
+	 * Hash detachment and failed invalidation need separate lifecycle review.
+	 */
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe.ib1) !=
+	    AIROHA_FOE_STATE_BIND)
+		goto unlock;
+
+	if ((hwe.ib1 ^ e->data.ib1) & AIROHA_FOE_IB1_BIND_PACKET_TYPE)
+		goto unlock;
+
+	e->data.ib1 &= ~AIROHA_FOE_IB1_BIND_TIMESTAMP;
+	e->data.ib1 |= hwe.ib1 & AIROHA_FOE_IB1_BIND_TIMESTAMP;
 unlock:
 	spin_unlock_bh(&ppe_lock);
 }
