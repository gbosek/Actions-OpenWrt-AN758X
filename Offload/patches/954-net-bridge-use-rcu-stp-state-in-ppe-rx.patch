Subject: [PATCH] net: bridge: provide RCU STP state for Airoha PPE RX

RX/NAPI holds RCU, not RTNL. Keep STP checks while avoiding the RTNL-only
accessor. Export existing admission fences read-only for runtime diagnosis.

--- a/net/bridge/br_stp.c
+++ b/net/bridge/br_stp.c
@@ -83,6 +83,18 @@
 	return p->state;
 }
 EXPORT_SYMBOL_GPL(br_port_get_stp_state);
+
+/* RX callers cannot acquire RTNL. The bridge port lifetime is RCU protected. */
+u8 br_port_get_stp_state_rcu(const struct net_device *dev)
+{
+	struct net_bridge_port *p;
+
+	RCU_LOCKDEP_WARN(!rcu_read_lock_held(),
+			"br_port_get_stp_state_rcu() requires RCU");
+	p = br_port_get_check_rcu(dev);
+	return p ? READ_ONCE(p->state) : BR_STATE_DISABLED;
+}
+EXPORT_SYMBOL_GPL(br_port_get_stp_state_rcu);
 
 /* called under bridge lock */
 struct net_bridge_port *br_get_port(struct net_bridge *br, u16 port_no)
--- a/include/linux/if_bridge.h
+++ b/include/linux/if_bridge.h
@@ -186,6 +186,7 @@
 void br_fdb_clear_offload(const struct net_device *dev, u16 vid);
 bool br_port_flag_is_set(const struct net_device *dev, unsigned long flag);
 u8 br_port_get_stp_state(const struct net_device *dev);
+u8 br_port_get_stp_state_rcu(const struct net_device *dev);
 void br_offload_state_sync(const struct net_device *dev);
 clock_t br_get_ageing_time(const struct net_device *br_dev);
 #else
@@ -214,6 +215,11 @@
 	return BR_STATE_DISABLED;
 }
 
+static inline u8 br_port_get_stp_state_rcu(const struct net_device *dev)
+{
+	return BR_STATE_DISABLED;
+}
+
 static inline clock_t br_get_ageing_time(const struct net_device *br_dev)
 {
 	return 0;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1270,7 +1270,7 @@
 	 * prove STP/isolation eligibility in this early RX hook.
