+/* Only TC_SETUP_FT counts: TC flower/QoS blocks cannot activate this path.
+ * Called in process context by netdev flowtable bind/unbind. RX rechecks the
+ * reference under ppe_lock before committing, closing the last-unbind race.
+ */
+void airoha_ppe_flowtable_ref(struct airoha_ppe *ppe, bool bind)
+{
+	u32 hash, count = airoha_ppe_get_total_num_entries(ppe);
+	u32 sram_count = airoha_ppe_get_total_sram_num_entries(ppe);
+
+	spin_lock_bh(&ppe_lock);
+	if (bind) {
+		ppe->bridge_ft_refs++;
+		spin_unlock_bh(&ppe_lock);
+		return;
+	}
+	if (!ppe->bridge_ft_refs || --ppe->bridge_ft_refs) {
+		spin_unlock_bh(&ppe_lock);
+		return;
+	}
+	spin_unlock_bh(&ppe_lock);
+
+	for_each_set_bit(hash, ppe->bridge_fallback, count) {
+		struct airoha_foe_entry *hwe;
+		int err = 0;
+
+		spin_lock_bh(&ppe_lock);
+		if (ppe->bridge_ft_refs) {
+			spin_unlock_bh(&ppe_lock);
+			return;
+		}
+		if (!test_bit(hash, ppe->bridge_fallback)) {
+			spin_unlock_bh(&ppe_lock);
+			continue;
+		}
+		hwe = ppe->foe + hash * sizeof(*hwe);
+		hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+				      AIROHA_FOE_STATE_INVALID);
+		wmb();
+		if (hash < sram_count)
+			err = airoha_ppe_foe_commit_sram_entry(ppe, hash);
+		if (!err)
+			__clear_bit(hash, ppe->bridge_fallback);
+		else
+			ppe->bridge_fallback_fault = true;
+		spin_unlock_bh(&ppe_lock);
+		if (err) {
+			/* Abort at the first timeout, not once per remaining SRAM slot. */
+			dev_warn(ppe->eth->dev,
+				 "bridge fallback cleanup failed (%d); hardware state unconfirmed\n", err);
+			return;
+		}
+		cond_resched();
+	}
+}
