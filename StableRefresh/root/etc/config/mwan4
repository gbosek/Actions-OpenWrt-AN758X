
config globals 'globals'
	option mmx_mask '0x3F00'
	option rule_mask '0x00fc0000'
	option source_routing '0'
	option xg2010g_rule_semantics '1'

config interface 'wan'
	option enabled '1'
	option id '1'
	option table_id '1'
	option mark '0x100'
	option track_method 'ping'
	option reliability '2'
	option count '3'
	option timeout '2'
	option interval '5'
	option down '5'
	option up '5'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	list track_ip '114.114.114.114'
	list family 'ipv4'

config interface 'wanb'
