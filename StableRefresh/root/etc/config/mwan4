config route 'wan_m1_w1'
	option interface 'wan'
	option metric '1'
	option weight '1'

config route 'wan_m2_w1'
	option interface 'wan'
	option metric '2'
	option weight '1'

config route 'wanb_m1_w1'
	option interface 'wanb'
	option metric '1'
	option weight '1'

config route 'wanb_m2_w1'
	option interface 'wanb'
	option metric '2'
	option weight '1'

config strategy 'balanced'
	option last_resort 'unreachable'
	list use_route 'wan_m1_w1'
	list use_route 'wanb_m1_w1'

config strategy 'wan_only'
	option last_resort 'unreachable'
	list use_route 'wan_m1_w1'

config strategy 'wanb_only'
	option last_resort 'unreachable'
	list use_route 'wanb_m1_w1'

config strategy 'wan_wanb'
	option last_resort 'unreachable'
	list use_route 'wan_m1_w1'
	list use_route 'wanb_m2_w1'

config strategy 'wanb_wan'
	option last_resort 'unreachable'
	list use_route 'wanb_m1_w1'
	list use_route 'wan_m2_w1'

