#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Use a positive whole number, or leave this empty for automatic assignment."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Stable ID"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"A number that keeps the firewall mark and routing table of this link the "
"same when links are added or reordered. If left empty, one is assigned "
"automatically."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"The routing table that holds the routes of this link. If left empty, the "
"stable ID is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"A number the router puts on the traffic of this link to tell which link it "
"must use. It must fit inside the global firewall mark mask. If left empty, "
"it is worked out from the mask and the stable ID."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Addresses used to test this WAN link. Use at least two: with a single target "
"one lost reply can mark the link down. If left empty, the link is not tested."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How each target is tested. Methods other than ping need extra tools and are "
"listed only when installed. Ping by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Use HTTPS for web page requests"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Make web page requests use HTTPS instead of HTTP. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How many targets must answer for the link to count as healthy; 1 means any "
"one is enough. If left empty, 1 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Tries per target"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How many tries are sent to each target in one round of checks. If left "
"empty, 1 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Ping size (bytes)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Size of each ping packet. If left empty, 56 bytes are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Ping hop limit"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How many routers a ping may cross before it is dropped. If left empty, 60 is "
"used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Wait for an answer (seconds)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How long one try waits for an answer before it counts as lost. If left "
"empty, 4 seconds are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Time between two rounds of checks while the link is healthy. Low values "
"notice problems sooner but may mark a shaky link down too eagerly. If left "
"empty, 10 seconds are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Check every (seconds) after a failure"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Time between rounds right after a check fails, to confirm quickly whether "
"the link is down. If left empty, 5 seconds are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Check every (seconds) while recovering"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Time between rounds while a down link is tested for recovery. If left empty, "
"5 seconds are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How many failed checks in a row mark the link down. High values tolerate "
"short glitches but react later. If left empty, 5 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How many good checks in a row bring a down link back. If left empty, 5 is "
"used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Keep checking quickly while down"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Keep using the faster interval after a failure until the link recovers, "
"instead of slowing down. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Besides answering, a link is marked degraded when replies are slow or lost, "
"using the limits below. Needs the Ping method. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Reply time above which the link counts as degraded. If left empty, 1000 ms "
"is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Share of lost replies above which the link counts as degraded. If left "
"empty, 40 % is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Reply time the link must stay under to count as healthy again. If left "
"empty, 500 ms is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Share of lost replies the link must stay under to count as healthy again. If "
"left empty, 10 % is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"The bits of the firewall mark MultiWAN 4 may use, so its marks never clash "
"with other software. Use enough set bits for every WAN link plus the "
"reserved marks. If left empty, 0x3F00 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Source routing (by source address)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Also route by the source address of the traffic, not only by its firewall "
"mark. Turn it on for MPTCP or VRF-style setups. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Extra routing tables to look in, besides the main one, when working out "
"where traffic goes, for example the table of a VPN. If left empty, only the "
"main table is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"Write a log line when traffic matches a routing rule that has Log matches "
"turned on. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid ""
"How important the log lines of MultiWAN 4 are marked in the system log. "
"notice by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "Pause links that keep flipping"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "Flips that count as unstable"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "Count flips over (seconds)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "Pause an unstable link for (seconds)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "Wait before reusing a recovered link (seconds)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "Keep connections of a downed link for (seconds)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid ""
"Keep a link out of use after repeated up/down flips, so traffic stays on "
"steadier links."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid ""
"How many times a link may go from up to down inside the counting time before "
"it is paused (at least 2)."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "The time over which those flips are counted (at least 30 seconds)."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/stability.js
msgid "How long a paused link must stay healthy before it is used again."
msgstr ""

